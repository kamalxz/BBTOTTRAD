```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Data and temporary files
*.csv
*.tmp

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# Dependencies
.venv/
venv/
node_modules/

# Build artifacts
dist/
build/
target/

# Editors
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.coverage.*
.pytest_cache/
.mypy_cache/

# Compression files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```